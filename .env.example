# PostgreSQL connection string (MUST be PostgreSQL in production - the server
# refuses to start with a SQLite file URL, because SQLite is wiped on redeploy).
# For local dev, use a local PostgreSQL server (e.g. via Docker:
# docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres).
# For production on Render, a free PostgreSQL database is auto-provisioned.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pksingh?schema=public

# Stable JWT secret. MUST be set to a strong, persistent value in production
# (do NOT use auto-generated values — those get regenerated on every deploy
# and will log all users out).
LOCAL_JWT_SECRET=pksingh-jwt-secret-change-this-to-a-strong-random-value

# REQUIRED in production for permanent file storage (see src/utils/envSecurity.ts).
# Without them, uploaded course material falls back to local disk, which is
# wiped on every redeploy/restart on Render - uploaded videos would silently
# disappear. The server boots but prints a loud warning and the admin Dashboard
# shows an amber storage warning until these are set. A PARTIAL set (only one
# of the two keys) makes the server refuse to start.
# Setup: Supabase project -> Storage -> "New Bucket" -> name it exactly
# "media" -> make it Public. Also create a second bucket named exactly
# "backups" (for automatic daily backups). Then paste the URL/keys from
# Supabase -> Project Settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=media

# Shared secret that lets the automatic daily backup (GitHub Actions cron)
# trigger a backup without an admin login. Set the SAME value here and in
# GitHub -> Settings -> Secrets and variables -> Actions -> BACKUP_CRON_TOKEN.
# Use a long random string, e.g. a 32+ character mix of letters and numbers.
BACKUP_CRON_TOKEN=

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Max size (in MB) for a single uploaded file (video/PDF/image/doc). 500MB
# comfortably fits a full lecture video. Files are streamed to disk, not
# buffered in memory, so this is safe even on low-RAM hosting plans. For
# very long recordings, upload to YouTube (Unlisted) and paste the link
# instead — no size limit and it streams better for students.
MAX_FILE_SIZE_MB=500
ALLOWED_MIME_TYPES=application/pdf,video/mp4,video/webm,video/quicktime,video/x-matroska,image/jpeg,image/png,image/webp,image/gif,image/svg+xml,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation
ADMIN_PASSWORD=changeme_replace_in_production
ADMIN_EMAIL=admin@example.com

# Payment Gateway (Razorpay) — ALL THREE must be set together, or all left
# empty to keep payments turned off (the server refuses to start on a partial
# set). Get the first two from https://dashboard.razorpay.com/ -> Settings ->
# API Keys. The webhook secret is a long random string you create yourself;
# set the webhook URL to https://<your-backend>/api/payments/webhook in the
# Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: override the Razorpay API base URL (used only for local testing
# against a mock gateway). Leave unset in production.
# RAZORPAY_API_BASE=https://api.razorpay.com
