# Copy to .env.local and fill in your own values.
# Do NOT prefix secrets with NEXT_PUBLIC_ — anything with that prefix ships to
# the browser and is visible to anyone.
NEXT_PUBLIC_API_URL=https://pksingh-backend.onrender.com/api
NEXT_PUBLIC_SITE_URL=https://pksingh-iitiim.vercel.app
# Direct WhatsApp chat number, e.g. 9198xxxxxxxx (leave empty to use community invite)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Social profile URLs — leave empty to hide the icon in the footer.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
# NEXT_PUBLIC_SENTRY_DSN=
