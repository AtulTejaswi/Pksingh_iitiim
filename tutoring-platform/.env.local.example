# ─── Frontend (Next.js on Vercel) environment variables ────────────────────
# Copy this file to `.env.local` for local development. On Vercel, set these
# in Project Settings -> Environment Variables (Production scope unless noted).

# Backend API base URL (no trailing /api — this file's code adds it). Defaults
# to the production backend; point it at http://localhost:4000/api for local
# development.
# NEXT_PUBLIC_API_URL=https://pksingh-backend.onrender.com/api

# Public site URL (used for canonical/SEO links). Defaults to the live site.
# NEXT_PUBLIC_SITE_URL=https://pksingh-iitiim.vercel.app

# Google Search Console verification token (content="..." value from the HTML
# tag method). When unset, no verification meta tag is rendered.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Shared cron token — MUST be the exact same value as on the Render backend
# and in the GitHub Actions secrets. The daily quotes cron
# (/api/cron/quotes, scheduled in vercel.json) sends this to the backend's
# token-protected /api/quotes/cron endpoint. If it is missing, the quotes
# cron will fail with a clear error until it is set here.
# BACKUP_CRON_TOKEN=
